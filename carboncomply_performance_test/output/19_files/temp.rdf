  <rdf:Description rdf:about="https://data.com/cbam/emissionsqualifyingparameters#Aluminium_pre-consumer_scrap_THGDG2023070120230930_1">
    <rdf:type rdf:resource="https://purl.org/cbam/emissionsqualifyingparameters/Aluminium_pre-consumer_scrap"/>
    <rdf:type rdf:resource="https://purl.org/cbam/emissionsqualifyingparameters/EmissionParameter"/>
    <rdfs:label>Aluminium_pre-consumer_scrap</rdfs:label>
