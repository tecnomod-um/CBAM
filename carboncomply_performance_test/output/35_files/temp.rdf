    <rdf:type rdf:resource="https://purl.org/cbam/emissionsqualifyingparameters/Precursor_reducing_Agent"/>
    <rdfs:label>Precursor_reducing_Agent</rdfs:label>
    <ontology-se-cbam_emissionsqualifyingparameters:code>QPD10</ontology-se-cbam_emissionsqualifyingparameters:code>
    <ontology-se-cbam_emissionsqualifyingparameters:code>QPD11</ontology-se-cbam_emissionsqualifyingparameters:code>
    <ontology-se-cbam_emissionsqualifyingparameters:description>The main reducing agent used in the production of the precursor (pig iron or direct reduced iron), if known. If more than one is used, fill in the one which is predominant in the production process. (Possible values: "Coke"; "Coal"; "Fuel oil"; "Natural gas"; "Hydrogen"; "Charcoal or biomass"; "Other"; "Not applicable")</ontology-se-cbam_emissionsqualifyingparameters:description>
